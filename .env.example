# WHOOP OAuth (https://developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Optional: skip OAuth and use a personal access token for local experiments
WHOOP_ACCESS_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Force demo fixtures even when OAuth tokens exist (omit or set live for real WHOOP)
# WHOOP_MODE=demo

# Frontier model dictation (optional — Bayesian composer works without these)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Kitchen enroll (from production Annashakti)
DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM=Annashakti <hello@annashakti.org>
KITCHEN_KEY=first-hundred
